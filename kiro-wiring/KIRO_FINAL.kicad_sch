	(label "F_B" (at 944.88 741.68 0) (effects (font (size 5.0 5.0)) (justify left bottom)) (uuid "5940d36b-910d-5b82-b41b-3bbfbc3b7dd4"))
	(text "Servo types: wheels ST3215-C018 (12 V); arms STS3215 (5 V rail, 8.0 V limit)." (exclude_from_sim no) (at 60.96 807.72 0) (effects (font (size 4.2 4.2)) (justify left)) (uuid "ef4c476f-19b5-552e-b5f8-78e77dc41317"))
	(text "HOW THE E-STOP WORKS" (exclude_from_sim no) (at 497.84 55.88 0) (effects (font (size 5.0 5.0) (bold yes)) (justify left)) (uuid "eb8b3c4f-e293-5c82-a001-399f390c74be"))
	(text "1. Normal run: E-STOP (SW2, NC) is closed, relay K1 coil (86-85) gets 12 V, contact 30-87 closes." (exclude_from_sim no) (at 497.84 71.12 0) (effects (font (size 4.2 4.2)) (justify left)) (uuid "8c1cae03-2bf2-528f-839d-42f2b84cd768"))
	(text "2. Press E-STOP: coil loses power, K1 opens, +12V_MOTOR is dead. FB1 -> wheels and FB1 -> buck -> FB2 -> both arms stop." (exclude_from_sim no) (at 497.84 83.82 0) (effects (font (size 4.2 4.2)) (justify left)) (uuid "c1b97abc-ae1d-5658-a013-c3720408d616"))
	(text "3. Jetson (F1) is before K1 on +12V_MAIN and keeps running. Twist E-STOP to release: K1 closes and motor power returns." (exclude_from_sim no) (at 497.84 96.52 0) (effects (font (size 4.2 4.2)) (justify left)) (uuid "e0453659-6395-5cc5-b7f0-17c10a0d8fb0"))
	(text "K1: 12 V relay, coil 86/85, contact 30 -> 87 rated >= 40 A DC. D1 across the coil (cathode to 86) kills the turn-off spike." (exclude_from_sim no) (at 497.84 109.22 0) (effects (font (size 4.2 4.2)) (justify left)) (uuid "d455c4f8-9ad2-52c5-87e6-4b5029b2ac6c"))
	(text "FB1 is fed ONLY from K1 pin 87. F1 (Jetson) and F6 (E-STOP) use their own inline fuse holders on +12V_MAIN." (exclude_from_sim no) (at 497.84 121.92 0) (effects (font (size 4.2 4.2)) (justify left)) (uuid "642b7d82-364f-5171-b098-0da923ef5631"))
	(text "NEVER connect 12 V to FB2 or an arm adapter: arm servos are limited to 8.0 V." (exclude_from_sim no) (at 497.84 134.62 0) (effects (font (size 4.2 4.2)) (justify left)) (uuid "c3b66912-8591-52d4-99f3-b07c6b772e64"))
	(text "Software: stop the robot program (torque off) before releasing E-STOP. EA75-5V buck is 15 A TOTAL for both arms." (exclude_from_sim no) (at 497.84 147.32 0) (effects (font (size 4.2 4.2)) (justify left)) (uuid "21e132e3-1d09-5c54-bb8c-2e8be5fdce70"))
