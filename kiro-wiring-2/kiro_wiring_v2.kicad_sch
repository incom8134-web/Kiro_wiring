  (text "KIRO Wiring V2  |  System_Overview"
    (at 20.32 17.78 0)
    (effects (font (size 3.5 3.5) (bold yes)) (justify left bottom))
    (uuid "92cdae54-1ec7-4561-bd9e-a8f3c5a46ec0")
  )
  (text "Battery-powered KIRO robot: 12 V 45 Ah battery, Jetson Orin Nano Super, 4-wheel mecanum (ST3215), LeRobot leader + follower arms, 2 cameras, 1 LiDAR, mushroom E-stop + contactor, red motion-warning light"
    (at 20.32 24.13 0)
    (effects (font (size 1.5 1.5)) (justify left bottom))
    (uuid "6cd9cb01-92f4-42a6-8c28-50afdac9206b")
  )
  (text "POWER DOMAINS"
    (at 20.32 193.04 0)
    (effects (font (size 1.8 1.8) (bold yes)) (justify left bottom))
    (uuid "71bede3c-21d7-475b-9481-3ca9b2a543df")
  )
  (text "BATTERY_RAW ......... battery after F_MAIN and SW_MAIN (10.0-14.6 V worst case)         not cut by E-stop"
    (at 20.32 198.12 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid "2769ad84-f1c5-43ba-b9df-5232bd27bae9")
  )
  (text "COMPUTE_POWER ....... F_JETSON -> ideal-diode -> Jetson J16                            not cut by E-stop"
    (at 20.32 202.18 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid "274c6b19-c015-4b49-a5ba-7504eca5403c")
  )
  (text "USB_SENSOR_5V ....... F_HUB -> hub PSU -> powered USB hub (cameras/LiDAR on USB)        not cut by E-stop"
    (at 20.32 206.25 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid "838bfb24-6377-46a6-83b2-4b6bdc361cb2")
  )
  (text "CTRL_12V ............ F_CTRL -> mushroom NC -> START / K1 AUX -> K1 coil                 E-stop loop"
    (at 20.32 210.31 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid "94d27b88-5add-4582-ab7c-f8817385a4c5")
  )
  (text "12V_AFTER_CONTACTOR . K1 main contact output = DRIVE_ARMED                             cut by E-stop"
    (at 20.32 214.38 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid "b03d4e30-98dd-4efe-b20c-cd3054d1d027")
  )
  (text "DRIVE_POWER / REGULATED_12V .. F_DRIVE -> 12 V stabiliser -> wheel adapter             cut by E-stop"
    (at 20.32 218.44 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid "698fef3f-a8d5-4f1a-8c3f-344b8d8de40c")
  )
  (text "ARM_POWER ........... F_ARM_IN -> EA75-5V -> F_LEADER / F_FOLLOWER                      cut by E-stop"
    (at 20.32 222.5 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid "88b58b94-a437-46e3-9bed-db81c239f506")
  )
  (text "BEACON_12V .......... F_BEACON -> red light, low-side MOSFET                            cut by E-stop"
    (at 20.32 226.57 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid "ecf928dd-2ce4-49e5-b4db-fc3a79bf2ef4")
  )
  (text "LOGIC_3V3 / JETSON_LOGIC_GND .. Jetson J12 pin 1 / pin 6 (buffers only)   LOGIC_5V (J12 pin 2): unused"
    (at 20.32 230.63 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid "d7e3d7f5-3609-436e-9d13-d8083e0994de")
  )
  (text "POWER_GND ........... single star point at battery negative"
