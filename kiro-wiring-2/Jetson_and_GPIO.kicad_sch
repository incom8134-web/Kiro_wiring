  (text "KIRO Wiring V2  |  Jetson_and_GPIO"
    (at 20.32 20.32 0)
    (effects (font (size 3 3) (bold yes)) (justify left bottom))
    (uuid "b01adb8c-8cf7-47ae-bcdf-8afd5684def9")
  )
  (text "NVIDIA Jetson Orin Nano Super Developer Kit, reference carrier: J16 DC jack, J12 40-pin header, J6/J7 USB"
    (at 20.32 25.4 0)
    (effects (font (size 1.5 1.5)) (justify left bottom))
    (uuid "84607e3d-8fe3-4dff-b14f-38f8339f8cf3")
  )
  (text "J12 HEADER FACTS (NVIDIA carrier spec)"
    (at 20.32 35.56 0)
    (effects (font (size 1.5 1.5) (bold yes)) (justify left bottom))
    (uuid "e42ce8b6-bf6e-4f6f-a8bf-f72d76871256")
  )
  (text "All J12 signals 3.3 V. Non-I2C pins go through TI TXB0108 level translators: drive only +/-20 uA."
    (at 20.32 40.64 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid "93f3e1bd-ad88-4a55-87e2-aa6b1b77605c")
  )
  (text "External pull-ups/pull-downs on these pins must be > 50 kOhm. Never load a J12 pin directly."
    (at 20.32 45.72 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid "2cfb686b-87ef-47c2-b1f3-5f61093327d0")
  )
  (text "Therefore every GPIO here meets a 74LVC1G17 buffer (CMOS input, push-pull output)."
    (at 20.32 50.8 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid "10e86481-db57-4784-98de-1eb5e3522a35")
  )
  (text "Pins 29/31/7 are PROPOSED. Pinmux, boot state and state after cleanup: bench-verify (TBD)."
    (at 20.32 55.88 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid "26fb7f7b-0650-4482-969d-25dfcee185c4")
  )
  (text "J16: 9-20 V, 5.5 x 2.5 mm, centre positive, max 3.5 A. Raw battery 10-14.6 V is inside range."
    (at 20.32 60.96 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid "f5141142-80ac-49d3-ae34-ca52b99a49be")
  )
  (text "Do NOT use hardware PWM for BEACON_HOLDOFF_PULSE: it must stop when software freezes."
    (at 20.32 66.04 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid "5b0bb552-bb2f-4932-a588-9a1d5f24ac20")
  )
  (text "R21 1k: GPIO -> buffer input (light sheet).  R22/R23 100R: buffer output -> TXB0108 B-side (overdrive)."
    (at 20.32 153.67 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid "ff461ecf-0014-483c-83f4-1bdb69c6a160")
  )
  (text "NT1: J12 GND and J16 DC return are the same carrier-board ground. No extra wire to POWER_GND."
    (at 20.32 158.75 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid "78423575-44e3-422d-8b0a-b924c4f6af23")
  )
  (text "USB PORT ASSIGNMENT"
    (at 284.48 71.12 0)
    (effects (font (size 1.5 1.5) (bold yes)) (justify left bottom))
    (uuid "e0aa1e25-9db5-45cd-8ea2-0024759f1be2")
  )
  (text "J6 port 1: Orbbec Gemini 335 (USB 3.2 Gen1, bundled cable, never via hub)"
    (at 284.48 76.2 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid "e02f3db5-0c95-4dc9-8e32-752618bfaae2")
  )
  (text "J6 port 2: powered USB hub upstream (LiDAR + 3x CH343 servo adapters)"
    (at 284.48 81.28 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid "33cd5313-d769-4a26-a32f-63c9ae72410d")
  )
  (text "J7 port 1: Suyin wrist webcam.   J7 port 2: spare.   Each J6/J7 stack: 3 A VBUS total."
    (at 284.48 86.36 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid "df395703-a010-48e9-a520-d2187819f010")
  )
  (text "J15 GbE, J5 USB-C, J20/J21 CSI, J14 buttons: present on the carrier, not used in V2 (no-connect)."
    (at 284.48 91.44 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid "bbb89ab8-0a48-4c31-ba11-f24e24e89c87")
  )
