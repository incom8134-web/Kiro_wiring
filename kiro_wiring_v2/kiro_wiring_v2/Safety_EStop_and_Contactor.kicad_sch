  (text "KIRO Wiring V2  |  Safety_EStop_and_Contactor"
    (at 20.32 20.32 0)
    (effects (font (size 3 3) (bold yes)) (justify left bottom))
    (uuid "f95b337a-a116-43e4-a36d-d0ca4af226de")
  )
  (text "Hard-wired self-holding contactor loop. No software in the safety path."
    (at 20.32 25.4 0)
    (effects (font (size 1.5 1.5)) (justify left bottom))
    (uuid "fd855c67-76ad-4f92-a7c1-c359f6646150")
  )
  (text "AUX 13-14 = self-hold contact, wired parallel to START"
    (at 177.8 88.9 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid "a9dbbeab-7f29-4e85-8597-54bae1fecae3")
  )
  (text "ESTOP_OK_N to Jetson: LOW = 12V_AFTER_CONTACTOR present."
    (at 132.08 106.68 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid "d303ef3a-0693-4383-b2a2-309a438aa9a0")
  )
  (text "Opto LED on POWER_GND side; transistor on Jetson logic side."
    (at 132.08 111.76 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid "e2325955-15a0-409e-b20b-f37be1872abc")
  )
  (text "Pull-up and 74LVC1G17 buffer: Jetson_and_GPIO sheet."
    (at 132.08 116.84 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid "586d0b8c-6eef-47bb-ba04-0fe102a34bb1")
  )
  (text "Broken wire -> pull-up -> HIGH -> software treats as E-stop."
    (at 132.08 121.92 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid "45ea7968-be3b-44f7-baf6-88a34dd8c10d")
  )
  (text "E-STOP BEHAVIOUR"
    (at 20.32 137.16 0)
    (effects (font (size 1.5 1.5) (bold yes)) (justify left bottom))
    (uuid "a041d389-65c3-4e30-8654-76ee4f6ca22b")
  )
  (text "Press mushroom -> NC 11-12 opens -> coil current stops -> K1 opens -> 12V_AFTER_CONTACTOR = 0 V (wheels, arms, light)."
    (at 20.32 142.24 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid "4455a67a-7c22-4113-97fc-e2fc715bc781")
  )
  (text "Broken loop wire or blown F_CTRL -> same drop-out. Releasing the mushroom does not re-close K1 (AUX 13-14 open)."
    (at 20.32 147.32 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid "e829e731-423d-4e44-a2e3-a6e6de169f9b")
  )
  (text "Restart: twist-release mushroom, then press START deliberately. COMPUTE_POWER is upstream of K1: Jetson stays up."
    (at 20.32 152.4 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid "7ce9851b-1f7a-4970-b9f9-1397669e91c5")
  )
  (text "D2 bidirectional TVS clamps coil kick-back without the slow release of a plain flyback diode. Verify vs coil datasheet."
    (at 20.32 157.48 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid "1e04817f-baf6-4107-8495-f3452ead7581")
  )
  (text "GENERIC: E-stop 1NC block 11-12; K1 12 V coil <= 1.5 A, main 80 A DC, AUX NO 13-14. Replace with real part data."
    (at 20.32 162.56 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid "b8c051de-5d58-4495-9ab2-d548b342359d")
  )
  (text "If K1 has no AUX NO: add a 12 V relay, coil parallel to K1 coil, and use its NO contact for the self-hold."
    (at 20.32 167.64 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid "c32b3cdf-a596-4d60-90f5-173213d5ec73")
  )
