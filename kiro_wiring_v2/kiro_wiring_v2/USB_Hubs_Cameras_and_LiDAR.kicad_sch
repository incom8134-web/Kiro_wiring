  (text "KIRO Wiring V2  |  USB_Hubs_Cameras_and_LiDAR"
    (at 20.32 20.32 0)
    (effects (font (size 3 3) (bold yes)) (justify left bottom))
    (uuid "0e647874-5ce0-4705-b96a-6cfbf574d5f5")
  )
  (text "Only the installed hub, two cameras and one LiDAR. No other sensors."
    (at 20.32 25.4 0)
    (effects (font (size 1.5 1.5)) (justify left bottom))
    (uuid "2dc14cb7-33a9-4996-b90d-927ff8c41289")
  )
  (text "DEVICE TABLE"
    (at 20.32 127 0)
    (effects (font (size 1.5 1.5) (bold yes)) (justify left bottom))
    (uuid "05edcb3b-367d-4284-bf0c-76a7645617fb")
  )
  (text "Gemini 335   | USB bus 5 V | 896 mA max, <6.5 W | USB 3.2 Gen1 | bundled cable | Jetson J6 port 1 direct"
    (at 20.32 132.08 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid "bededfbd-8d52-4f4f-ac55-5b6aca500130")
  )
  (text "Wrist webcam | USB bus 5 V | needs 500 mA       | USB 2.0      | camera cable  | Jetson J7 port 1 direct"
    (at 20.32 137.16 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid "777d685a-340d-4afe-bc4a-2facb9962f84")
  )
  (text "RPLIDAR C1   | 5 V via USB | 230 mA typ, peak TBD | UART 460800 inside, USB outside (CP2102N) | hub DS1"
    (at 20.32 142.24 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid "b036de4b-6c5a-4bc6-83a2-180cf527379b")
  )
  (text "USB hub      | DC in 5 V 4 A, barrel 5.5 x 2.1 mm, centre positive (GEN - check against real hub label)"
    (at 20.32 147.32 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid "0931b724-6954-4a49-bb43-cace70c581be")
  )
  (text "Hub barrel: if the real hub is 3.5x1.35 or 5.5x2.5 mm, change the plug; never trust \"5 mm\" alone."
    (at 20.32 152.4 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid "f126f213-afd6-430f-a060-e3a39088fd79")
  )
  (text "Shielding: use shielded USB cables; route away from servo and 12 V harnesses. No motor current returns via USB."
    (at 20.32 157.48 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid "c23742ca-f4e8-4c84-8a50-5493f1212f1f")
  )
  (text "LiDAR start-up (V1): plug sensor cable into adapter with USB unplugged, then connect USB. Motor spin-up after host opens port."
    (at 20.32 162.56 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid "6a87b5f3-1faf-4fcd-aac5-f5ffea2d740b")
  )
