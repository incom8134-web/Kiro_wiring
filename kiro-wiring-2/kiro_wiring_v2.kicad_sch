    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid "4b574f40-1fb1-4c50-a882-4636919450cd")
  )
  (text "Signals to/from Jetson: ESTOP_OK_N (in, LOW = armed), BEACON_STATE_N (in, LOW = light on), BEACON_HOLDOFF_PULSE (out, >=100 Hz = light off; stopped = MOTION_WARNING_REQUEST)."
    (at 20.32 243.84 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid "9e32a320-886c-4677-88ff-caa493def918")
